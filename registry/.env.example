DATABASE_URL=postgresql://sigil:sigil@localhost:5432/sigil
# Supply a matching RSA keypair. Encode PEM newlines as literal \n.
REGISTRY_PRIVATE_KEY_PEM=
REGISTRY_PUBLIC_KEY_PEM=
# Optional fallback only when there is no public request Host.
REGISTRY_DOMAIN=
# Trust forwarded host/protocol only from these proxy addresses or CIDRs.
FORWARDED_ALLOW_IPS=127.0.0.1,::1
# Reserved SMTP settings; registry email delivery is not implemented yet.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM_ADDRESS=
