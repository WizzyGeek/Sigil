# Suggestions for new identities; users can change connections in the UI.
# Public registries must use HTTPS. HTTP is permitted only on loopback hosts.
VITE_REGISTRY_URL=http://localhost:8000
# /ws uses the development proxy below. Direct ws:// or wss:// URLs also work.
VITE_DEFAULT_BROKER_URL=/ws
VITE_DEFAULT_CHANNELS=general
# Match the broker's MAX_CONTENT_BYTES, MAX_FRAME_BYTES, and MAX_RELAY_BATCH.
VITE_MAX_NOTE_BYTES=4096
VITE_MAX_FRAME_BYTES=262144
VITE_HISTORY_BATCH_SIZE=25
# Response collection / retry timeout; milliseconds (500..60000), three attempts.
VITE_HISTORY_TIMEOUT_MS=5000
VITE_REGISTRY_TIMEOUT_MS=10000
# Optional source/setup links. Omit this to hide those landing-page links.
VITE_REPOSITORY_URL=https://github.com/WizzyGeek/Sigil
# Development-server setting, not shipped to browsers. Compose overrides this.
DEV_BROKER_PROXY_URL=ws://localhost:8080
