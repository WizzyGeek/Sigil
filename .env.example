# ── Registry ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://sigil:sigil@localhost:5432/sigil
REGISTRY_PRIVATE_KEY_PEM=<paste RSA 4096 private key PEM, newlines as \n>
REGISTRY_PUBLIC_KEY_PEM=<paste RSA 4096 public key PEM, newlines as \n>
REGISTRY_DOMAIN=localhost:8000

# Optional: email recovery
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM_ADDRESS=noreply@example.com

# ── Broker ────────────────────────────────────────────────────────────────────
REGISTRY_PUBLIC_KEY_URL=http://localhost:8000/registry/public-key
BROKER_PORT=8080

# ── Client (Vite VITE_ prefix required) ───────────────────────────────────────
VITE_REGISTRY_URL=http://localhost:8000
VITE_DEFAULT_BROKER_URL=ws://localhost:8080/ws
