# ── Registry ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://sigil:sigil@localhost:5432/sigil
REGISTRY_PRIVATE_KEY_PEM=<paste RSA 4096 private key PEM, newlines as \n>
REGISTRY_PUBLIC_KEY_PEM=<paste RSA 4096 public key PEM, newlines as \n>
# IPs or CIDRs of reverse proxies allowed to supply forwarded headers.
FORWARDED_ALLOW_IPS=127.0.0.1,::1
# Optional fallback for requests without Host (never overrides a request host).
REGISTRY_DOMAIN=

# Reserved: email delivery is not implemented yet
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM_ADDRESS=noreply@example.com

# ── Broker ────────────────────────────────────────────────────────────────────
# Explicit local mapping; public issuers are discovered over HTTPS automatically.
REGISTRY_KEY_URLS='{"localhost:8000":"http://localhost:8000/registry/public-key"}'
REGISTRY_KEY_TTL_SECONDS=300
BROKER_PORT=8080

# ── Client (Vite VITE_ prefix required) ───────────────────────────────────────
VITE_REGISTRY_URL=http://localhost:8000
VITE_DEFAULT_BROKER_URLS='["/ws"]'
# Legacy single-broker fallback (used when the JSON list is absent/invalid):
# VITE_DEFAULT_BROKER_URL=/ws

# Optional client suggestions and links
VITE_DEFAULT_CHANNELS=general
VITE_MAX_NOTE_BYTES=4096
VITE_MAX_FRAME_BYTES=262144
VITE_HISTORY_BATCH_SIZE=25
VITE_HISTORY_TIMEOUT_MS=5000
VITE_REGISTRY_TIMEOUT_MS=10000
VITE_REPOSITORY_URL=https://github.com/WizzyGeek/Sigil
# Only needed for the Vite /ws development proxy
DEV_BROKER_PROXY_URL=ws://localhost:8080
