BROKER_PORT=8080
# Public issuers are discovered over HTTPS. This mapping enables local HTTP.
# Docker Compose supplies its own mapping to the registry container.
REGISTRY_KEY_URLS='{"localhost:8000":"http://localhost:8000/registry/public-key"}'
REGISTRY_KEY_TTL_SECONDS=300
MIN_FRESHNESS_SCORE=1
MAX_FRAME_BYTES=262144
MAX_CONTENT_BYTES=4096
MAX_RELAY_BATCH=25
# Legacy optional mapping for the endpoint URL's own host:
# REGISTRY_PUBLIC_KEY_URL=http://localhost:8000/registry/public-key
